{
  "manifest_version": 3,
  "name": "browser-daemon relay",
  "version": "0.4.0",
  "description": "Local CDP relay for browser-daemon (Mode B, --backend extension). Connects to ws://127.0.0.1:19989 and proxies chrome.debugger commands.",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "activeTab",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "ws://127.0.0.1/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "browser-daemon relay",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
